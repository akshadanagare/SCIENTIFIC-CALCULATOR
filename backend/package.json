{
  "name": "mathcorner-api",
  "version": "2.0.0",
  "private": true,
  "description": "Fastify + PostgreSQL API for MathCorner: calculation history and saved preferences",
  "engines": { "node": ">=20" },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig-build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "pg-mem": "^3.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
