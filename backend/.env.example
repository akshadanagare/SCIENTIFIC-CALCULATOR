# Server port and host
PORT=3001
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/calculation

# Set to true for hosted databases that need SSL (Render, Neon, Supabase, etc.)
DB_SSL=false

# Comma-separated list of allowed CORS origins (leave empty to allow all)
CORS_ORIGIN=

# Logger level (info, debug, warn, error)
LOG_LEVEL=info
